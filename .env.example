# Data experiments work without an external API; LLM chat requires a model key.
APP_PORT=8080
BIND_HOST=127.0.0.1
STUDIO_ACCESS_TOKEN=
WEB_CONCURRENCY=2

# Optional LLM conversation (server-side only; no credentials in the frontend).
# The assistant reports unavailability explicitly when unconfigured.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
# For Linux server deployments, use scripts/deploy.py to persist credentials
# outside the release and mount the API key as a Docker Compose secret file.
